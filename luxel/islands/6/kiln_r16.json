  "design": {
    "idea": "The Twin-Temper Crucible magnum-opus 4-quadrant puzzle: flip kiln_heat to low to expose the 8-tile phantom trench (Lens), light 3 clustered timed braziers in one Scatter fan, pierce twin armoured couplers with Lance, bank a Skip shot off the north wall to drop the inner gate, shatter the obsidian seal with Sunflare, and yank the East Casting Clamp.",
    "kind": "puzzle",
    "beat": "ketsu",
    "teaches": "Full Island 6 synthesis: Heat Flow + Lens + Scatter + Lance + Skip + Sunflare in one spiral.",
    "decisions": 12,
    "expert_s": 60,
    "reward": "kiln_cast_east+shortcut_r11+open_r17",
    "why": "Climax puzzle of the Heat-Flow Casting Wing releasing the East Casting Clamp.",
    "exit": "exit_kiln_r16_west",
    "start": { "vars": { "dungeon:great_kiln:kiln_heat": "surge" }, "moves": ["sunflare"], "ember": 100, "flags": ["crucible_weaver_defeated", "kiln_cast_key_2"], "keys": { "wick_key": 1 } },
    "solution": [
      { "op": "goto", "to": [80, 192], "tol": 4.0 },
      { "op": "interact", "target": "lever_r16_damper" },
      { "op": "expect", "var": "dungeon:great_kiln.kiln_heat==low" },
