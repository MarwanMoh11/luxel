      { "op": "goto", "to": [392, 208], "tol": 4.0 },
      { "op": "shoot", "target": [448, 208], "count": 2, "wait_hit": 0.30 },
      { "op": "wait_until", "target": "door_r16_q2", "prop": "opened", "value": true, "timeout": 3.5 },
      { "op": "goto", "to": [456, 94], "tol": 4.0 },
      { "op": "interact", "target": "anvil_r16_lance" },
