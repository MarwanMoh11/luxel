  "design": {
    "idea": "Inside the Iron Colossus's Jaw and Crown Cockpit looking out through twin blazing furnace eye-windows at the miniature caldera below: pull the west shutter rope to expose the compass orbs, shoot 3 -> 1 -> 4 -> 2 matching the glowing eye-glass pips, pull the east rudder lock to steer the giant toward High Trestle, then unlock the Boss Heart Hatch!",
    "kind": "puzzle",
    "beat": "ketsu",
    "teaches": "Reading diegetic eye-window clues + pull_ring shutter + sequence_orbs + rudder steering climax before r11 boss",
    "decisions": 8,
    "expert_s": 50,
    "reward": "colossus_steered+boss_anchor+open_r11",
    "why": "Jaw-dropping story-meets-puzzle climax giving the player direct helm control over the walking giant and an 8s boss retry checkpoint.",
    "exit": "exit_r10_east",
