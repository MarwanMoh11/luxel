  "design": {
    "idea": "Monumental 3-tier ribbed Belly Furnace Cathedral central hub overlooking the molten Heart core: test new Heat-Boots stability against the ambient tilting crate, forge Skip, pull the Cycle 2 Emergency Chute & External Crane winches, and branch freely into Left Shoulder (r7) or Right Shoulder (r8) before climbing the Sternum Gate (r10).",
    "kind": "traversal",
    "beat": "sho",
    "teaches": "Heat-Boots footing stability, Belly Cathedral hub geography, Cycle 2 chute & Skip anvil",
    "decisions": 5,
    "expert_s": 50,
    "reward": "ws_colossus_belly+temper_skip_known+colossus_chute_open+colossus_belly_lift",
    "why": "Architectural heart of The Iron Colossus tying lower limbs, overworld lift, both shoulder wings, and crown sternum together.",
    "exit": "exit_r6_chute",
    "start": {
      "flags": [
        "piston_marshal_defeated",
        "item_heat_boots"
      ]
    },
    "solution": [
      {
        "op": "interact",
        "target": "ws_colossus_belly"
      },
      {
        "op": "goto",
        "to": [
          168,
          268
        ],
        "tol": 4.0
      },
      {
        "op": "interact",
        "target": "anvil_r6_skip"
      },
      {
        "op": "expect",
        "var": "wick_temper==skip"
      },
      {
        "op": "goto",
        "to": [
          424,
          256
        ],
        "tol": 4.0
      },
      {
        "op": "throw",
        "target": "ring_r6_chute",
        "hold": 0.4
      },
      {
        "op": "recall"
      },
      {
        "op": "wait_until",
        "flag": "colossus_chute_open",
        "timeout": 3.0
      },
      {
        "op": "wait_until",
        "target": "door_r6_chute",
        "prop": "opened",
        "value": true,
        "timeout": 3.0
      },
      {
        "op": "expect_exit",
        "exit": "exit_r6_chute"
      }
    ]
  }
