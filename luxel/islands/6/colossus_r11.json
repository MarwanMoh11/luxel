  "design": {
    "idea": "Ribcage Core boss showdown against The Colossus Heart: shatter its 4 Steam Valves in P1 to drop its iron cage, then in P2/P3 freeze dripping slag_slimes with flanking Blue Transformers right along the swinging Heart's pendulum arc so it crashes face-first into its own frozen add, earning Half-Lantern #2 and popping open the Spine Escape Hatch!",
    "kind": "boss",
    "beat": "ketsu",
    "teaches": "Full Iron Colossus mastery: Heat-Boots on double-speed tilt + Blue-freezing live slimes inside pendulum arc",
    "decisions": 8,
    "expert_s": 145,
    "reward": "half_lantern_6b+colossus_heart_beaten+open_r12",
    "why": "Dungeon B climax boss delivering Half-Lantern #2 and stabilizing the walking giant's heartbeat.",
    "exit": "exit_r11_north",
