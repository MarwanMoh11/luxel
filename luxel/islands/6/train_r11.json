  "design": {
    "idea": "Locomotive Cab boss showdown against The Engineer: dodge Coal-Shovel Spreads, Brake-Lurches, and Whistle Steam Lanes in P1; survive the dramatic P2 roof blow-off layer swap & Parallel Rail-Drone; snap his P3 twin Boiler Pressure Chains to claim Half-Lantern #1 and Pane Cinder Blast!",
    "kind": "boss",
    "beat": "ketsu",
    "teaches": "Full Ember Express mastery: live temper swapping, Lance vs Rail-Drone, and breaking P3 boiler chains",
    "decisions": 7,
    "expert_s": 140,
    "reward": "half_lantern_6a+pane_cinder_blast+express_cleared",
    "why": "Climax boss of The Ember Express delivering Half-Lantern #1 and Pane Cinder Blast.",
    "exit": "exit_r11_return",
    "start": {
      "flags": [
        "brakeman_defeated",
        "item_coupler_hook",
        "temper_skip_known",
        "temper_scatter_known",
        "temper_lance_known"
      ]
    },
    "solution": [
      {
        "op": "clear",
        "timeout": 180.0
      },
      {
        "op": "wait_until",
        "flag": "express_cleared",
        "timeout": 6.0
      },
      {
        "op": "interact",
        "target": "pane_r11_cinder"
      },
      {
        "op": "expect_exit",
        "exit": "exit_r11_return"
      }
    ]
  }
