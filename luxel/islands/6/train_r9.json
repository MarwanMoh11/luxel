  "design": {
    "idea": "Astonishing 3-Temper Uncoupling Gauntlet: (1) Skip-bank the rear brake coupler behind the baffle, (2) ride the lava shuttle cart and Hook-pull the mid hitch pin to drop the armor shutter, (3) pierce twin armoured pins in ONE Lance shot so the Tender slams open the Boiler Safe (Boss Key) and Cycle 3 Express Shortcut to r4!",
    "kind": "puzzle",
    "beat": "ketsu",
    "teaches": "Full synthesis of Skip + Shuttle Cart + Coupler Hook + Lance piercing in strict visual order",
    "decisions": 10,
    "expert_s": 60,
    "reward": "train_boss_key+ember_6_train+train_tender_short",
    "why": "Climax puzzle of The Ember Express rewarding the Locomotive Boss Key, secret Ember Piece, and Cycle 3 hub loop.",
    "exit": "exit_r9_north",
