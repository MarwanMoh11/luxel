  "design": {
    "idea": "Left Shoulder Winch master tilt puzzle: anchored by Heat-Boots, bounce Blue off twin transformers to quench two molten slag bumpers, position them to catch both sliding crates on Right Step, bank a Skip bolt around the iron screen to open the orb shutter, and drop the light orb onto the east groove so all plates lock on ONE Right Step, snapping the West Shoulder Chain!",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Heat-Boots + dual cooled slag bumpers + Skip bank shot + sliding carry_orb synchronized on one giant stride",
    "decisions": 10,
    "expert_s": 60,
    "reward": "col_left_lock+open_r9_west",
    "why": "Peak stride-physics puzzle uniting slag cooling, Skip wall-ricochet, and Heat-Boots stability.",
    "exit": "exit_r7_north",
