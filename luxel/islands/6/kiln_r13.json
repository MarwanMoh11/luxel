  "design": {
    "idea": "The Thermal Bridge Foundry: under kiln_heat==surge, ride thermal updraft bridges across twin lava canyons, clear two Smelter Wasps, bank twin Skip bolts off the north and south crucible hoods to unlock the West Casting Clamp, claim kiln_cast_key_1, and drop straight back to kiln_r11 via Cycle 5.",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Surge thermal updraft crossing + dual Skip wall-bank uncoupling + West Casting Clamp release.",
    "decisions": 10,
    "expert_s": 60,
    "reward": "kiln_cast_west+kiln_cast_key_1+chute_r11",
    "why": "West Casting Wing climax releasing the West Casting Clamp and awarding Casting Key #1.",
    "exit": "exit_kiln_r13_chute",
