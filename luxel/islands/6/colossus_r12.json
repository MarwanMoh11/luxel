  "design": {
    "idea": "THE COLLAPSE RUN: sprint across crumbling spine grates (buffered by Heat-Boots), hit the steam-jet launch pad over a 5-tile gear chasm to the mid anchor, slip past the rotating spine gear, bank a Skip bolt off the north hull into the recessed Shoulder Vent lock, and leap out into the Stride Flats sunset as the Colossus kneels!",
    "kind": "setpiece",
    "beat": "ketsu",
    "teaches": "Kinetic synthesis of Heat-Boots crumble timing + bounce_bloom launch + spinner dash + Skip vent lock",
    "decisions": 8,
    "expert_s": 60,
    "reward": "colossus_cleared",
    "why": "Thrilling zero-combat kinetic escape finale rewarding every Iron Colossus skill with instant checkpoints.",
    "exit": "exit_r12_east",
