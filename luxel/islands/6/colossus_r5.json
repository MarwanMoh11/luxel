  "design": {
    "idea": "Tilting Knee Piston Chamber mini-boss showdown against The Piston Marshal: stay uphill on every giant footstep so his downhill jackhammer lunges jam in the deck, quench his steam vent via corner coolant crystals or crack armor with Lance, claim Cleated Heat-Boots, and drop the Cycle 1 Service Ladder to r2!",
    "kind": "boss",
    "beat": "sho",
    "teaches": "Reading giant stride downhill vectors in combat + awards Cleated Heat-Boots dungeon power",
    "decisions": 6,
    "expert_s": 90,
    "reward": "item_heat_boots+colossus_knee_ladder+open_r6",
    "why": "Mid-dungeon climax transforming stride tilt into a combat weapon and unlocking Heat-Boots for the upper torso.",
    "exit": "exit_r5_north",
