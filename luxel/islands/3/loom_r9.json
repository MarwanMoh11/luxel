  "design": {
    "idea": "The Cathedral of One Thread: five floating islands hang on one continuous 6-spool silk line; lock the west deck with the stone block, freeze the center spool blue as a firebreak, weave a Brass Shuttle bypass to the east half, and burn the east counterweight so its plunge hoists the Boss Key bridge straight to r2 (Cycle 3).",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Astonishing synthesis of push-block deck locking, Blue silk firebreak, Brass Shuttle bypass weaving, and counterweight hoisting.",
    "decisions": 12,
    "expert_s": 66,
    "reward": "keepers_flame_loom+cycle_3_bridge",
    "why": "Signature astonishing room of The Weaver's Loom awarding the Boss Key and opening Cycle 3.",
    "exit": "exit_loom_r9_north",
