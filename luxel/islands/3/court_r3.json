    "beat": "ten",
    "teaches": "Anchor-spool unhorsing, dynamic verdict-mutated arena, Verdict 2 choice",
    "decisions": 8,
    "expert_s": 76,
    "reward": "Sets court_v2 (mercy|fire) + Cycle 1 juror shortcut",
    "why": "Escalates the Briar Court trial by paying off Verdict 1 terrain and setting up Verdict 2",
