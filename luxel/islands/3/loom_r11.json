  "design": {
    "idea": "Octagonal six-spoke radial web arena for The Loom Widow: ignite the rim spool of the spoke she clings to (0.9 s ember burn warning) to drop her onto the central brass spindle for punish, cut P2 rim tethers, and claim Half-Lantern #2 + Ember Piece.",
    "kind": "boss",
    "beat": "ketsu",
    "teaches": "Climax mastery of silk-spoke ignition, tether cutting, and agile dodge windows against The Loom Widow.",
    "decisions": 8,
    "expert_s": 122,
    "reward": "half_lantern+ember_piece+loom_done",
    "why": "Climax boss of The Weaver's Loom awarding Half-Lantern #2 (+1 Heart with Under-Root) and Ember Piece.",
