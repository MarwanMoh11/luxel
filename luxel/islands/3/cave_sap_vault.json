  "design": {
    "idea": "Two-scale Sap Vault: shrink via an in-room stump into a sealed inner chamber, roll and rotate a Blue Transformer onto the pinhole line, return to normal scale, and fire a charged Beam through the grate pinhole into the transformer to latch the vault's blue switch_eye for Pane Canopy Dew.",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "in-room stump_shrink toggle, grate pinhole Beam refraction, Blue Piercing Beam, Canopy Dew Pane",
    "decisions": 8,
    "expert_s": 58,
    "reward": "Pane canopy_dew, lore_sap_vault, 50 shards",
    "why": "Signature late-Island-3 Beam + Shrink synthesis secret rewarding Canopy Dew Pane",
    "optional": true,
