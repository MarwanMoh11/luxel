  "design": {
    "idea": "Western Whispering Wood clearing showcasing the Shifting Woods rule: unlit wood_pin_lamp rotates wood_turn (0=Great Stump, 1=Amber Well, 2=Crown Bridge) when leaving unpinned, while lighting it pins the clearing; static S/E exits guarantee zero softlocks.",
    "kind": "puzzle",
    "beat": "ki",
    "teaches": "wood_pin_lamp, eff_turn_w layers, burrow_beetle + dandelion_drifter patrol",
    "decisions": 4,
    "expert_s": 44,
    "reward": "Pinned routing to Under-Root, Amber Well, and Crown Thicket",
    "why": "First-3-minute Shifting Woods discovery beat with fair readable compass and zero softlocks",
    "optional": true,
    "start": {
      "vars": {
        "island:3:wood_turn": 1,
        "island:3:eff_turn_w": 1,
        "island:3:pin_w": 0
      }
    },
