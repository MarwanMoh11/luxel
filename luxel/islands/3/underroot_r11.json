  "design": {
    "idea": "Boss vault for Hundred Lamps: a 10-segment centipede vulnerable on DARK segments while your 1.8x sun-lantern lights any segment you approach \u2014 hang light on flank hooks behind root pillars, strike dark rings, and snuff P2 light-eggs to claim Half-Lantern #1 and Pane ember_seed.",
    "kind": "boss",
    "beat": "ketsu",
    "teaches": "Climax mastery of The Under-Root's inverted light rule: casting shadow wedges behind root pillars and extinguishing light-eggs.",
    "decisions": 8,
    "expert_s": 120,
    "reward": "half_lantern+pane_ember_seed+underroot_done",
    "why": "Climax boss of The Under-Root awarding Half-Lantern #1 and the ember_seed Stained-Glass Pane.",
    "exit": "exit_r11_return_ow",
    "solution": [
      {
        "op": "clear",
        "zone": "ur_r11",
        "timeout": 120.0
      },
      {
        "op": "wait",
        "secs": 0.45
      },
      {
        "op": "expect",
        "flag": "underroot_done"
      },
      {
        "op": "interact",
        "target": "pane_r11_ember_seed"
      },
      {
        "op": "wait_until",
        "interactable": "door_r11_north",
        "prop": "opened",
        "value": true,
        "timeout": 3.0
      },
      {
        "op": "expect_exit",
        "exit": "exit_r11_return_ow"
      }
    ]
  },
