  "design": {
    "idea": "The Canopy Split (Big + Tiny Synthesis): defeat the Bramble Knight and False Lantern, drop the Cycle 6 SW shortcut to oak_r6b, flood sap high to wake the central Shrink Stump, dive tiny into the sealed east bark fissure to align the Blue Transformer, return normal, fire Beam through the pinhole grate into the blue eye, and unlock Key #3's door to oak_r9.",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Sap-powered Shrink Stump + tiny fissure alignment + normal-scale pinhole Blue Beam + Key #3 lock",
    "decisions": 10,
    "expert_s": 58,
    "reward": "Cycle 6 shortcut to oak_r6b + Key #3 route to oak_r9",
    "why": "Synthesizes Sap Clock, Shrink Stump, Blue Prism, and Beam in one unforgettable room",
