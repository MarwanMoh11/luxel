  "design": {
    "idea": "Master the Brass Shuttle by throwing your lantern from the shuttle spool onto mid-chasm hooks to weave a custom conducting silk wire across two unlinked seed-bridges, snapping Boss Key Anchor #1 in the NE (plus an optional NW weave for Lost Moth #9).",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Brass Shuttle custom wire weaving (throw from shuttle spool to hook -> recall -> shoot spool to send spark down your custom line) + dry anchor snapping.",
    "decisions": 10,
    "expert_s": 58,
    "reward": "loom_anchor_1+moth_3_09+r8_access",
    "why": "First Wing 2 showcase proving the Brass Shuttle item transforms unlinked islands into custom circuits.",
    "exit": "exit_loom_r7_north",
    "start": {
      "flags": [
        "brass_shuttle"
      ]
    },
