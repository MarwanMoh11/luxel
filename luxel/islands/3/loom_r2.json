  "design": {
    "idea": "Multi-level Heddle Hub with the Boss Key hanging in a glass bobbin over the central pit; rotate the east Blue Transformer, shift the Warp-Wheel to lower the SW shuttle track, and freeze the tension spool blue before it snaps back so you can cross into the West Wing.",
    "kind": "puzzle",
    "beat": "ki",
    "teaches": "Hub macro-state (loom_warp high/low) pinned with Blue silk-freeze; previews Boss Key bobbin, Key Door, Boss Door, and upper cycle landings.",
    "decisions": 5,
    "expert_s": 52,
    "reward": "r3_access+hub_orientation",
    "why": "Central multi-level hub linking all four cycles and teasing every major Weaver's Loom landmark.",
    "exit": "exit_loom_r2_sw",
