  "design": {
    "idea": "Twin-Sluice Water Scale: Sluice-Harpoon a heavy cargo barge over the submerged West Scale Pan, then flip lock_water to east_high so its dry 3.0 weight tips the scale while flooding the East Mirror-Raft into line with the latch eye.",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Grounded cargo Tide Rafts outweigh Wick (3.0 vs 1.0) on Scales; linked lock_water solves both basins in one flip.",
    "decisions": 9,
    "expert_s": 56,
    "reward": "whirlpool_access",
    "why": "Synthesizes Sluice Harpoon towing, linked lock_water, Tide Raft grounding mass, and floating mirror banks before the centerpiece.",
    "exit": "exit_r9_north",
