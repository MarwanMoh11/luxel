  "design": {
    "idea": "Deepened Optical Prism Rotunda (D06 8-tile un-zippable chasm + D25a fixed): claim PRISM SPLIT at shrine_prism, bank off Mirror A to extend the 128px bridge, then align Mirror B to 225 deg and fire ONE Prism-Split 3-ray fan striking all 3 north eyes simultaneously \u2014 opening East (r6), igniting Optic Well W2 (relay_f2), unlocking NE Tri-Ray Sluice (r14), and opening the South shortcut to r1!",
    "kind": "puzzle",
    "beat": "sho",
    "teaches": "Claiming PRISM SPLIT and firing a single 3-way fan (0 deg, +-18 deg) to hit a simultaneous 3-eye triad.",
    "decisions": 7,
    "expert_s": 50,
    "reward": "prism_split+relay_f2+r1_shortcut+r14_access",
    "why": "Signature permanent-move shrine room of Island 2.",
    "exit": "exit_lh_r5_east",
