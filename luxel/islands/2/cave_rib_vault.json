  "design": {
    "idea": "Rotate a grounded Tide Raft mirror while the rib cavern is drained dry, then open the flood-valve to float the raft up to blue-beam height and unseal the compass vault.",
    "kind": "puzzle",
    "beat": "sho",
    "teaches": "Dry-setup -> flood-elevation Tide Raft mirror bank",
    "decisions": 6,
    "expert_s": 52,
    "reward": "quest_item brass_compass + moth_2_06",
    "why": "Ebb-tide secret cave in Shipwreck Shoals driving Ferry Beetle's Regatta quest",
    "optional": true,
    "target": "item_brass_compass",
