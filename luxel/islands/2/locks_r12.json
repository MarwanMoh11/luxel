  "design": {
    "idea": "Double-Lock Sanctum Boss Arena: Twin Lockmasters Brine and Bilge share one sea-glass hex shield across 4 Blue Portals while flipping lock_water between lateral sluices every 12 seconds; victory awards Half-Lantern #2 and locks_done.",
    "kind": "boss",
    "beat": "ketsu",
    "teaches": "Synthesizes portal-line reading, mid-swap shield knocks, blue mirror flanking, and linked sluice shifts across 3 escalating boss phases.",
    "decisions": 10,
    "expert_s": 138,
    "reward": "locks_done+half_lantern_2+cycle_5",
    "why": "Climax boss of The Smugglers' Locks awarding Half-Lantern #2 and setting locks_done to awaken The Leviathan.",
