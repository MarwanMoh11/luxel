  "design": {
    "idea": "Octagonal flooded Dredge Basin where Wick duels The Dredge Hulk turret-barge from the Skiff moat or quay mirrors, batting wake mines into its stern to win the Sluice Harpoon and unlock the East Aqueduct shortcut to r2.",
    "kind": "boss",
    "beat": "sho",
    "teaches": "Flank armored hull with blue mirror banks and wake-mine bats; claim Sluice Harpoon to tow floating rafts and mines.",
    "decisions": 7,
    "expert_s": 90,
    "reward": "power_sluice_harpoon+cycle_2",
    "why": "Mid-dungeon mini-boss exam awarding the Smugglers' Locks signature power and opening Cycle 2 back to Lock Junction.",
