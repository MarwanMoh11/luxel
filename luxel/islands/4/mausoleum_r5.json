  "design": {
    "idea": "Chamfered octagonal rain-chapel mini-boss arena against The Cloud-Urn Deacon: spin WIND to blow open and shatter his 3 orbiting rain-urns, flip SUN to evaporate his rain-shield for bonus Beam damage, claim Key 1, and open Cycle 1's west shortcut back to Cistern Nave.",
    "kind": "boss",
    "beat": "sho",
    "teaches": "Boss weather counterplay: WIND exposes orbiting shields, SUN evaporates rain armor.",
    "decisions": 6,
    "expert_s": 85,
    "reward": "ms_key_1+ms_west_shortcut+45_shards",
    "why": "West Flood Wing climax awarding the key to the East Gale Wing and closing Cycle 1.",
    "exit": "exit_ms_r5_shortcut",
