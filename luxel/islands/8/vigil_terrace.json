    "beat": "ki",
    "teaches": "toll_scale + THE LANTERN ASKS + Redemption Desk + Folk Quests + 80-Moth Arch",
    "decisions": 3,
    "expert_s": 50,
    "reward": "unlock_west_east_wings",
    "why": "Unforgettable Island 8 first-3-minutes reveal of the sold-settings rule and safe camp anchor.",
