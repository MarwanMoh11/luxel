  "design": {
    "idea": "Grand Gilded Basilica Apse hosting Boss THE TOLLMASTER: bank blue bolts off twin flanking mirrors behind his Lectern Shield, smash his Brass Register (or sell a setting!) during P2 & P3 Invoices, and earn +1 Half-Lantern plus 1 Free Redemption Receipt!",
    "kind": "boss",
    "beat": "ketsu",
    "teaches": "Boss-scale synthesis of Island 8's Sold-Settings choice vs pure manual-aim counterplay.",
    "decisions": 8,
    "expert_s": 125,
    "reward": "toll_cleared+half_lantern+redemption",
    "why": "Climactic counting-house boss unlocking 1/3 of the Triple Eclipse Seal and Free Redemption at Vigil Terrace.",
