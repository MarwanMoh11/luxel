  "design": {
    "idea": "Chamfered Audit Chamber hosting Mini-Boss The Chief Auditor: rotate Bolt, Throw, and Beam to beat his Audit Stamp, then claim the Brass Receipt, small key, and East shortcut to the Narthex.",
    "kind": "boss",
    "beat": "sho",
    "teaches": "Kit rotation against audited moves; awards Brass Receipt dungeon power and Toll House Cycle 1 shortcut.",
    "decisions": 6,
    "expert_s": 85,
    "reward": "item_brass_receipt+toll_key+short",
    "why": "Climax of the West Interface Wing, awarding the Brass Receipt needed for the East Feel Wing.",
    "exit": "exit_r5_east_short",
    "solution": [
      {
        "op": "clear",
        "timeout": 95.0
      },
      {
        "op": "wait_until",
        "flag": "chief_auditor_defeated",
        "timeout": 5.0
      },
      {
        "op": "interact",
        "target": "altar_r5_receipt"
      },
      {
        "op": "expect",
        "flag": "item_brass_receipt"
      },
      {
        "op": "interact",
        "target": "key_toll_1"
      },
      {
        "op": "wait_until",
        "target": "door_r5_balc",
        "prop": "opened",
        "value": true,
        "timeout": 3.0
      },
      {
        "op": "shoot",
        "from": [
          344,
          168
        ],
        "target": "switch_r5_short"
      },
      {
        "op": "wait_until",
