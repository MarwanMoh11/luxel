  "design": {
    "idea": "H-Shaped Rail-Chasm Still Ledger: clear the disguised Page Wraith (instantly exposed if world_anims is sold!), shoot switch_r8_rot1, ride the recoil rail cart across the star-chasm to turn rotor_r8_2, align the double blue-mirror beam through the north grate, cross the raised bridge for Key 2 & West mid-bridge, and unlock North -> r9!",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "vehicle_cart recoil crossing + rotor-mounted blue_transformer relay + grate sightline; opens Cycle 2 bridge to r3.",
    "decisions": 9,
    "expert_s": 55,
    "reward": "toll_key+mid_bridge",
    "why": "Climax of the Feel Wing (camera_shake + world_anims), uniting cart traversal with multi-rotor optics.",
    "exit": "exit_r8_north",
