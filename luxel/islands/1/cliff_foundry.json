  "design": {
    "idea": "Coastal bronze bell foundry south of the Glasshouse: shatter the War shutter, ignite 3 cooled bronze moulds with one Dawn ring for Grandma's hearth quest, and branch to Foundry Ring-Dash and Lens Grotto.",
    "kind": "puzzle",
    "beat": "sho",
    "teaches": "War waves shatter shutters and Dawn waves light multiple foundry moulds simultaneously.",
    "decisions": 6,
    "expert_s": 65,
    "reward": "foundry_hearth_lit+hub_door_1+trial_and_grotto_access",
    "why": "Southern industrial bell-casting wing tying War/Dawn acoustics to Grandma's Wick House quest.",
    "optional": true,
    "exit": "exit_cf_trial",
