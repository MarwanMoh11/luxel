  "design": {
    "idea": "Chime Town hub camp centered on the Town Bell that flips Bell Isle between Evening and Midnight, with 3 folk quests, a Midnight ghost-stone pond, Wick House portal, and the Carillon Ear-Test.",
    "kind": "story",
    "beat": "ki",
    "teaches": "Tolling the Town Bell flips Bell Isle to Midnight, raising ghost pond stones and opening graveyard/manor secrets.",
    "decisions": 5,
    "expert_s": 75,
    "reward": "bell_hour_midnight+moth_1_02+carillon_trophy+hub_portal",
    "why": "Living emotional anchor of Bell Isle connecting overworld, graveyard, forecourt, Echo Well, and Wick House.",
    "optional": true,
    "exit": "exit_town_west",
