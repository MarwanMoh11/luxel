  "design": {
    "idea": "First Echo Clapper puzzle: throw at the West Dawn Bell to arm a 1.4s delayed Echo, recall, dash the chasm, and strike the East Dusk Bell in overlap.",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Echo Clapper's 1.4s delayed second wave lets Wick bridge time-and-distance gaps that single bolt strikes cannot span.",
    "decisions": 8,
    "expert_s": 55,
    "reward": "uc_backdoor_open",
    "why": "Split acoustic chasm validating mastery of the Echo Clapper before the deep east wing.",
    "exit": "exit_r6_north",
    "start": {
      "flags": [
        "item_echo_clapper"
      ]
    },
    "solution": [
      {
        "op": "goto",
        "to": [
          80,
          144
        ]
      },
      {
        "op": "throw",
        "target": "bell_r6_dawn",
        "hold": 0.25
      },
      {
        "op": "recall"
      },
      {
        "op": "goto",
        "to": [
          132,
          172
        ]
      },
      {
        "op": "dash",
        "dir": [
          1,
          0
        ]
      },
      {
        "op": "goto",
        "to": [
          392,
          168
        ]
      },
      {
        "op": "shoot",
        "target": "bell_r6_dusk"
      },
      {
        "op": "wait_until",
        "interactable": "door_r6_north",
        "prop": "opened",
        "value": true,
        "timeout": 3.5
      },
      {
        "op": "clear",
        "timeout": 18.0
      },
      {
