  "design": {
    "idea": "Boss The Chandelier swings overhead on 4 (or 3 with Right Verdict!) ceiling chains; vibrate chains brittle with the West War Bell, snap them to drop its molten wax heart, and relight P2 blackout sconces with the East Dawn Bell.",
    "kind": "boss",
    "beat": "ketsu",
    "teaches": "Mastery of Bell Isle's War and Dawn tones in a three-phase ballroom duel rewarding Half-Lantern #2 and the Stolen Clapper.",
    "decisions": 8,
    "expert_s": 130,
    "reward": "manor_cleared+half_lantern_2",
    "why": "Grand ballroom climax of The Bellmaker's Manor completing the Twin-Clapper Seal requirement.",
