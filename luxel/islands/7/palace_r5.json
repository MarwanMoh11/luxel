  "design": {
    "idea": "Mini-boss THE SILVER-TIDE MIMIC copies Wick's last move; bait with Bolts or Lens, flip Black in P2 to crack its mirror shell, then claim Moon-Glass Pocket, Key 1, and the foyer shortcut.",
    "kind": "boss",
    "beat": "sho",
    "teaches": "Baiting move-copy tells, flipping Silver->Black mid-boss to crack mirror armor, and unlocking Moon-Glass Pocket.",
    "decisions": 6,
    "expert_s": 85,
    "reward": "item_moon_pocket+palace_key_1+r1_short",
    "why": "West Wing climax awarding the dungeon's signature power (Moon-Glass Pocket) and closing Cycle 1 back to the foyer.",
    "exit": "exit_r5_east_short",
    "solution": [
      { "op": "goto", "to": [240, 216], "tol": 14 },
      { "op": "interact", "target": "pool_r5_center" },
      { "op": "clear", "timeout": 110.0 },
      { "op": "wait_until", "flag": "palace_miniboss_done", "timeout": 5.0 },
      { "op": "interact", "target": "altar_r5_pocket" },
      { "op": "interact", "target": "palace_key_1" },
      { "op": "shoot", "from": [368, 200], "target": "sw_r5_short" },
      { "op": "wait", "secs": 0.25 },
      { "op": "expect_exit", "exit": "exit_r5_east_short" }
    ]
