  "design": {
    "idea": "Two-world balance scale vault: load the Silver pan with a stone block and stone orb (weight 3), then smuggle a Light Orb through the Moon Pool into Black and guide your mirrored Mimic Statue north onto the Black pan (1+2=3) to unlock Key 2 and the Conservatory.",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Combining persistent Silver counterweights, Moon-Pocket orb smuggling, and Black-world mimic_statue alignment on a two-pan scale.",
    "decisions": 9,
    "expert_s": 55,
    "reward": "palace_key_2+ember_7_palace",
    "why": "Signature East Wing logic puzzle rewarding Small Key #2 and the dungeon's Ember Piece.",
    "exit": "exit_r8_north",
    "start": {
      "flags": ["item_moon_pocket"]
    },
    "solution": [
