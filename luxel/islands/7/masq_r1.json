  "design": {
    "idea": "Eight masked Wicks waltz in twin West and East ovals beneath gilded chandeliers; read their cast shadows in both ovals to unmask the TWO truthful guests casting warm SE shadows.",
    "kind": "setpiece",
    "beat": "ki",
    "teaches": "Compares SE truth shadows against NW/absent liar shadows across both waltzing ovals under chandelier light without resetting on a wrong unmask.",
    "decisions": 7,
    "expert_s": 50,
    "reward": "masq_r1_done+ballroom_seal",
    "why": "Theatrical opening beat of The Masquerade turning Island 7's Shadow-Truth law into a live twin-oval waltz puzzle.",
