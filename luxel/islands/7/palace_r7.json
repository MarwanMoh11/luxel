  "design": {
    "idea": "Half-Silver, half-Black pit stairwell: hang your lantern on the West Silver hook so its cross-world glow blooms a Black vine bridge across the chasm, ride the Black ferry to the East deck, then flip back to Silver to bank a Blue Bolt into the North bridge-lock.",
    "kind": "puzzle",
    "beat": "ten",
    "teaches": "Cross-world lantern hanging blooming Black light_plant bridges paired with moving_platform ferries and Silver-only transformers.",
    "decisions": 9,
    "expert_s": 55,
    "reward": "open_r9+stair_hub",
    "why": "Central vertical hub connecting West Wing (r3), East Cloister (r6), Conservatory (r9), and Ballroom loop (r10).",
    "exit": "exit_r7_east",
