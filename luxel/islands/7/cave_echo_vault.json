  "design": {
    "idea": "Twin-alcove velvet vault where flipping Black exposes two Puppets' spools & Moth 05, then hanging your lantern slips through a Shadow Gate into a Three-Chest Shadow-Truth test.",
    "kind": "combat",
    "beat": "ten",
    "teaches": "Use Black World to expose Puppet spools, hang your lantern to pass Shadow Gates unarmed, and pick the lone SE-shadow chest among two NW-shadow mimics.",
    "decisions": 8,
    "expert_s": 50,
    "reward": "ember_7_vault+moth_7_05",
    "why": "Combines combat, shadow_gate unarmed traversal, and the Shadow-Truth Law off Velvet Promenade.",
    "target": "chest_ember_7_vault",
