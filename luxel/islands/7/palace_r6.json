  "design": {
    "idea": "Three-chamber East Cloister teaching Moon-Glass Pocket: smuggle a Silver Light Orb across the Moon Pool flip to power a Black socket, claim Key 3, and slip unarmed through a Shadow Gate to unseal the Black Shoals backdoor.",
    "kind": "puzzle",
    "beat": "sho",
    "teaches": "Carrying a carry_orb through a moon_pool with item_moon_pocket, plus pairing lantern_hook with shadow_gate.",
    "decisions": 7,
    "expert_s": 50,
    "reward": "palace_key_3+black_shoals_backdoor",
    "why": "First East Wing room immediately paying off Moon-Glass Pocket and opening both Stairwell (r7) and Twin Scales (r8).",
    "exit": "exit_r6_north",
