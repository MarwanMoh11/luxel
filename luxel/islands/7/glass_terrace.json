  "design": {
    "idea": "Octagonal grand Spire forecourt joining Silver Quay, Velvet Promenade, Overworld Spire Threshold, and the Twin-Mask Gate to Masquerade & Mirror Spire.",
    "kind": "story",
    "beat": "ten",
    "teaches": "Converges both minor dungeons and the 3 Lunar Obelisks at the Twin-Mask Gate; post-relight Scribe Worm points Wick south to Zenith Atoll.",
    "decisions": 4,
    "expert_s": 45,
    "reward": "ws_glass_terrace+q7_noon_rumor+spire_entry",
    "why": "Grand architectural pivot before The Masquerade and Mirror Spire, keeping all 3 outer districts looped into one cycle.",
    "optional": true,
