static func resolve(sfx_id: String) -> Dictionary:
	if EXACT.has(sfx_id):
		return EXACT[sfx_id] as Dictionary
	var is_tell: bool = sfx_id.contains("_tell") or sfx_id.contains("_windup")
	if is_tell and (sfx_id.contains("_beam") or sfx_id.contains("_constellation") or sfx_id.contains("_eclipse")):
		return BEAM_TELL
	if is_tell and (sfx_id.contains("_slam") or sfx_id.contains("_stomp") or sfx_id.contains("_quake") or sfx_id.contains("_bell")):
		return SLAM_TELL
	for rule: Array in PATTERNS:
		for token: String in rule[0] as Array:
			if sfx_id.contains(token):
				return rule[1] as Dictionary
	return FALLBACK
