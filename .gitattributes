# Normalize text to LF in the repo
* text=auto eol=lf

# Godot text formats
*.gd        text eol=lf
*.gdshader  text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.import    text eol=lf
*.uid       text eol=lf
*.cfg       text eol=lf

# Tools and docs
*.py    text eol=lf
*.swift text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf

