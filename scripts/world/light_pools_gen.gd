extends SceneTree
## Writes light_pools.gd, the orchard's light pools that view.gd reads (scanning the pools' ground art at run time
## cost a texture readback and ~70k get_pixel calls). Rerun whenever godot_export.py regenerates the map:
##   godot --headless --path . --script res://scripts/world/light_pools_gen.gd

const ISLAND := "res://scenes/world/island.tscn"
const OUT := "res://scripts/world/light_pools.gd"
const POOL_COLOURS: Array[Color] = [Color8(255, 217, 140), Color8(245, 169, 106)] # gold, apricot: a pool's core
const POOL_CELL := 8 # px: core pixels are grouped in cells; touching cells make one pool


func _initialize() -> void:
	var island := (load(ISLAND) as PackedScene).instantiate()
	var pools := find_pools(island.get_node_or_null("GroundProps/orchard_lightpools") as Sprite2D)
	island.free()
	var rows := PackedStringArray()
	for p in pools:
		rows.append("\t%s," % var_to_str(p))
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("extends RefCounted\n## Generated by light_pools_gen.gd from the orchard_lightpools art: don't edit, rerun it when the map changes.\n"
		+ "## Each pool: x, y (world px), radius.\n\nconst POOLS: Array[Vector3] = [\n%s\n]\n" % "\n".join(rows))
	f.close()
	print("light pools: %d written to %s" % [pools.size(), OUT])
	quit()


## The orchard's light pools, from the pools' ground art: touching cells of core (gold, apricot) pixels.
static func find_pools(sprite: Sprite2D) -> PackedVector3Array:
	var pools := PackedVector3Array()
	if sprite == null:
		return pools
	var img := sprite.texture.get_image()
	if img == null or img.is_empty():
		return pools
	if img.is_compressed():
		img.decompress()
	var cells := {}
	for y in img.get_height():
		for x in img.get_width():
			var c := img.get_pixel(x, y)
			if c.a > 0.5 and (c.is_equal_approx(POOL_COLOURS[0]) or c.is_equal_approx(POOL_COLOURS[1])):
				@warning_ignore("integer_division")
				var k := Vector2i(x / POOL_CELL, y / POOL_CELL)
				cells[k] = int(cells.get(k, 0)) + 1
	var at0 := sprite.position + sprite.offset
	var seen := {}
	for start: Vector2i in cells:
		if seen.has(start):
			continue
		seen[start] = true
		var todo: Array[Vector2i] = [start]
		var sum := Vector2.ZERO
		var n := 0
		var count := 0
		while not todo.is_empty():
			var k: Vector2i = todo.pop_back()
			count += 1
			n += cells[k]
			sum += (Vector2(k) + Vector2(0.5, 0.5)) * POOL_CELL * cells[k]
			for dy in range(-1, 2):
				for dx in range(-1, 2):
					var nk := k + Vector2i(dx, dy)
					if cells.has(nk) and not seen.has(nk):
						seen[nk] = true
						todo.append(nk)
		if n >= 12: # a lone glint is not a pool
			var at := at0 + sum / n
			pools.append(Vector3(at.x, at.y, 14.0 + POOL_CELL * sqrt(count)))
	return pools
