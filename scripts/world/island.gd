class_name Island
extends Node2D
## The Last Light map (scenes/world/island.tscn, generated by docs/art_concepts/lastlight/godot_export.py:
## never edit the scene by hand). Props are Sprite2D strips positioned at their feet, in the groups
## role_<role> and setting_<id> (the settings whose sale changes them). Lit props carry a lights-off texture in
## metadata/unlit; the painted stars are their own layer (Stars, stars.gdshader). Colliders are StaticBody2D
## children: collision layer 1 = walk, 2 = shots, 3 = rough ground (slow, set by _refine_walk).
## apply(levels) shows the sales on the map; colliders never change.

const TICKS := 24 ## one world loop = 2 s at 12 fps; frame = tick * frames / TICKS, as in core.py
const FPS := 12.0
const STARS_GONE_AT := 30.0 ## % of PIXELS sold by which every star is dark; they go out bit by bit before that
const ROUGH_LAYER := 4 ## collision layer 3: ground you wade through (the flower beds' soil), queried, never collided with
const ROUGH_PROPS := "gh_bed" ## props whose walk colliders become rough ground
## bridge_south's walk collider (local): it follows the south parapet's top so feet stay on the painted deck, and
## ramps at both ends lead the road's south half up onto it instead of stopping Wick dead.
const BRIDGE_RAIL: Array[Vector2] = [Vector2(-15, 4), Vector2(-15, 0), Vector2(3, -12), Vector2(16, -12),
	Vector2(29, -13), Vector2(36, -14), Vector2(57, -14), Vector2(64, -13), Vector2(77, -12), Vector2(90, -12),
	Vector2(108, 0), Vector2(108, 4)]
const BRIDGE_NORTH_SORT := 341.0 ## the deck's back edge: whoever is on the deck draws in front of the north parapet

@export var map_size := Vector2(1280, 720)
@export var spawn := Vector2(640, 372)

var _props: Array[Sprite2D] = []
var _animated: Array[Sprite2D] = []
var _moving: Array[Sprite2D] = [] ## animated and not frozen by a sale
var _lit := {} ## Sprite2D (and Ground) with a lights-off version -> its lit texture
var _stars: Array[Sprite2D] = [] ## setting_pixels props, in the order they go out
var _time := 0.0
var _tick := -1
var _staging: Tween ## apply_staged's lights-out wave


func _ready() -> void:
	for layer: Node in [$GroundProps, $Sort, $Over]:
		for prop: Node in layer.get_children():
			if prop is Sprite2D:
				_props.append(prop)
	for s in _props + [$Ground as Sprite2D]:
		if s.has_meta("unlit"):
			_lit[s] = s.texture
	_animated = _props.filter(func(s: Sprite2D) -> bool: return s.hframes > 1)
	_stars = _props.filter(func(s: Sprite2D) -> bool: return s.is_in_group("setting_pixels"))
	_stars.sort_custom(func(a: Sprite2D, b: Sprite2D) -> bool: return hash(a.name) < hash(b.name))
	_refine_walk()
	apply({})


func _process(delta: float) -> void:
	_time = fmod(_time + delta, TICKS / FPS)
	var tick := int(_time * FPS + 0.0001) % TICKS
	if tick != _tick:
		_set_tick(tick)


## Shows the sold settings on the map. `levels` is the prototype's {setting id: times sold} (missing = 0,
## pixels = % dead), the same dictionary SettingsFX.apply takes. Selling back restores everything.
## PARTICLES hides motes, fireflies and petals; BRIGHTNESS switches the lanterns and lamps off and hides the
## light pools; ANIMATIONS freezes every animated prop on its first frame; SOUND stops the bells and chimes;
## PIXELS puts the stars out: the twinkling ones one by one, the painted ones pixel by pixel.
func apply(levels: Dictionary) -> void:
	if _staging:
		_staging.kill()
		_staging = null
	var particles := int(levels.get("particles", 0)) > 0
	var dark := int(levels.get("brightness", 0)) > 0
	var still := int(levels.get("animations", 0)) > 0
	var silent := int(levels.get("sound", 0)) > 0
	var dead := clampf(float(levels.get("pixels", 0)), 0.0, 100.0)
	for s: Sprite2D in _lit:
		s.texture = s.get_meta("unlit") if dark else _lit[s]
	var stars_out := {} # the twinkling stars PIXELS has put out; buying pixels back shows them again
	for i in _stars.size():
		if dead >= (i + 1) * STARS_GONE_AT / _stars.size():
			stars_out[_stars[i]] = true
	for s in _props:
		s.visible = not (particles and s.is_in_group("setting_particles")) \
			and not (dark and s.is_in_group("setting_brightness") and not _lit.has(s)) and not stars_out.has(s)
	($Stars.material as ShaderMaterial).set_shader_parameter("dead", clampf(dead / STARS_GONE_AT, 0.0, 1.0))
	_moving = _animated.filter(func(s: Sprite2D) -> bool:
		return not still and not (silent and s.is_in_group("setting_sound")))
	for s in _animated:
		s.frame = 0
	_set_tick(_tick if _tick >= 0 else 0)


## apply(levels), but BRIGHTNESS goes out as a wave over `secs`: the lit props go dark one by one from the
## farthest to `center` (default: the camera's centre, else the spawn), the light pools with them, the ground glow
## last. Everything else applies at once.
func apply_staged(levels: Dictionary, secs: float, center := Vector2.INF) -> void:
	var lit := levels.duplicate()
	lit["brightness"] = 0
	apply(lit)
	if int(levels.get("brightness", 0)) <= 0:
		return
	if center == Vector2.INF:
		var cam := get_viewport().get_camera_2d()
		center = cam.get_screen_center_position() if cam else spawn
	var wave: Array[Sprite2D] = []
	for s in _props:
		if _lit.has(s) or s.is_in_group("setting_brightness"):
			wave.append(s)
	wave.sort_custom(func(a: Sprite2D, b: Sprite2D) -> bool:
		return a.position.distance_squared_to(center) > b.position.distance_squared_to(center))
	_staging = create_tween()
	var gap := secs / maxf(wave.size(), 1.0)
	for s in wave:
		_staging.tween_callback(_go_dark.bind(s))
		_staging.tween_interval(gap)
	_staging.tween_callback(func() -> void:
		_staging = null
		apply(levels))


## Lit props (those with a lights-off texture), optionally only zone `zone`, sorted west to east.
func lit_props(zone := "") -> Array[Sprite2D]:
	var out: Array[Sprite2D] = []
	for s: Sprite2D in _lit:
		if s != $Ground and (zone == "" or s.get_meta("zone", "") == zone):
			out.append(s)
	out.sort_custom(func(a: Sprite2D, b: Sprite2D) -> bool: return a.position.x < b.position.x)
	return out


## Switches one lit prop (or the Ground's glow) on or off, whatever apply() last set.
func set_lit(s: Sprite2D, on: bool) -> void:
	if _lit.has(s):
		s.texture = _lit[s] if on else s.get_meta("unlit")


func _go_dark(s: Sprite2D) -> void:
	if _lit.has(s):
		s.texture = s.get_meta("unlit")
	else:
		s.visible = false


## Walk patches on top of the exported colliders (move them into world.py if they stay): the bridge's deck (the
## south rail, BRIDGE_RAIL; the north parapet's sort point) and the flower beds as rough ground (ROUGH_LAYER).
func _refine_walk() -> void:
	var north: Sprite2D = $Sort/bridge_north
	var lift := north.position.y - BRIDGE_NORTH_SORT
	north.position.y = BRIDGE_NORTH_SORT
	north.offset.y += lift
	for c: Node in north.get_children():
		(c as Node2D).position.y += lift # the collider stays where it was
	($Sort/bridge_south/BlocksWalk/Shape0 as CollisionPolygon2D).polygon = PackedVector2Array(BRIDGE_RAIL)
	for s in _props:
		if s.name.begins_with(ROUGH_PROPS):
			for body: StaticBody2D in s.find_children("*", "StaticBody2D", false, false):
				body.collision_layer = ROUGH_LAYER


## Adds a moving thing (player, enemy, pickup) to the y-sorted layer. Its origin must be at its feet.
func add_actor(actor: Node2D) -> void:
	$Sort.add_child(actor)


@warning_ignore("integer_division")
func _set_tick(tick: int) -> void:
	_tick = tick
	for s in _moving:
		s.frame = tick * s.hframes / TICKS
