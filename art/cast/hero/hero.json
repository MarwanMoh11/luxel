 "rig": {
  "layers": "Draw BODY then LANTERN at the same feet anchor; draw LANTERN first when lantern_behind. Pick lantern_t0/t1/t2 by the hero's power (glow tier 0..2). The cast sheets replace the lantern layer for their 4 frames, offset by (hand of the current body frame - rest_hand).",
  "rest_hand": {
   "front": [
    7,
    -9
   ],
   "side": [
    6,
    -9
   ],
   "back": [
    -10,
    -9
   ]
  },
  "hand": "per idle/hop/hurt frame: the lantern hand, anchor-relative (+x right, +y down)",
  "emit": "centre of the lantern glass, anchor-relative, in pixels (+x right, +y down); null = unlit",
  "mirror_left": "side faces right; for left flip the frames horizontally (axis = anchor x) and negate emit.x and hand.x",
  "directions": "front = moving down, back = moving up, side = left/right and diagonals",
  "glow_tiers": "lantern_t0 (base), t1, t2: brighter glass and a wider dithered halo; halo pixels over Wick are pre-lit cloak (one step lighter), so draw t* with its own body frame",
  "shadow": "sheets *_shadow.png, frames 56x18, anchor [20, 3] at the feet; one flat colour mask: shade the ground under it one step darker (core.SHADE). Draw it under everything.",
  "flash": "*_flash.png: cream silhouette inside the outline for idle, hop and hurt; swap the body sheet for it for one frame (~50 ms) on a hit. hurt frame 0 is already flashed.",
  "hit_stop": "suggested: freeze 50 ms on hurt frame 0 and on cast frame 1 (the flare)",
  "y_sort": "sort Wick by the feet anchor y"
