 "name": "Hush Owl",
 "id": "owl",
 "version": 1,
 "palette": {
  "void": "#0d0b1e",
  "night": "#211a3b",
  "dusk": "#3d2c5c",
  "plum": "#6a3d6f",
  "wine": "#a0466a",
  "coral": "#e2725b",
  "apricot": "#f5a96a",
  "gold": "#ffd98c",
  "cream": "#fff4dc",
  "pine": "#1d3d4c",
  "teal": "#2b6b68",
  "jade": "#4c9e78",
  "lime": "#a3cf7d",
  "deep": "#263873",
  "blue": "#3e6db0",
  "sky": "#78a9da",
  "ice": "#c7e5ef",
  "mauve": "#8a6e91",
  "stone": "#c2a7ae",
  "rose": "#ec9fa8"
 },
 "frame": [
  48,
  48
 ],
 "anchor": [
  24,
  40
 ],
 "shadow_frame": [
  56,
  20
 ],
 "shadow_anchor": [
  28,
  10
 ],
 "anchor_convention": "node position = the ground point under the owl; draw the shadow frame's anchor on it and the body frame's anchor (the owl's feet) at ground point - (0, frame_data.altitude).",
 "hit_radius": 7,
 "body_radius": 8,
 "body_box": [
  18,
  18
 ],
 "wingspan": 30,
 "rig": {
  "position": "the owl's node position is the GROUND POINT under it. Draw the shadow frame with its anchor on the ground point, then the body frame with its anchor (the feet) at ground point - (0, altitude). frame_data.altitude is per frame (the flap bob, the lock rise, the dive drop).",
  "hit_centre": "frame_data.hit_centre = the body centre relative to the GROUND POINT (= (0, -9) above the feet, plus the altitude; same meaning as the Magpie's): shots aim at it and hits test hit_radius around it, but only on frames where frame_data.targetable is true (see behaviour.targetable); shots never hit the shadow. The dive hurts Wick when hit_centre passes within hit_radius + 5 px of his body centre.",
  "layers": "SHADOW (ground layer) < dive_smear < BODY < EYES. EYES = pupils and their ice rings only; in the finale draw only EYES above the dead pixels. Every direction has eyes: from behind the owl turns its head back over its left shoulder, so a back-facing owl still shows two eyes (only closed-eye frames, the death puff and the dissolve have an empty EYES frame).",
  "flash": "*_flash.png: cream silhouette inside the outline; swap it for the body frame for 60 ms on a hit (HIT FLASH sold: skip). hurt and death frame 0 are already flashed.",
  "shadow": "one flat colour mask: shade the ground under it one step darker (core.SHADE). Flyer convention shared with the Magpie: almost under the bird, nudged (+2, +1) px, shrinking and thinning with altitude (solid and full size during the dive and the recover).",
  "mirror_left": "side faces right; the art is symmetric about the anchor's left pixel edge, so a flipped body frame is drawn at the same place (ground.x - AX). Flip the shadow too and draw it at ground.x - (SW - SAX) + 4, so its sun nudge stays east.",
  "directions": "front = flying down the screen, back = up, side = left/right and diagonals. While CIRCLING and in LOCK choose the direction from the vector to Wick (an owl keeps its face on its prey; it banks around him staring); in DIVE and RECOVER from the velocity.",
  "y_sort": "flying: draw above the y-sorted props and actors (it flies over them) while altitude >= 10; below that (the bottom of the dive, recover, the landed death) y-sort by the ground point.",
  "animations_sold": "loops hold frame 0 (the glide), one-shots show frame 0 for their whole duration (lock frame 0 is the full tell, dive frame 0 the smear frame)"
 },
 "behaviour": {
  "id": "owl",
  "from_s": 40,
  "hp": 3,
  "hp_in_code": 30,
  "xp": 2,
  "flies_over_props": true,
  "cruise": {
   "keep_distance_px": 80,
   "circle_speed_px_s": 48,
   "altitude_px": 20
  },
  "lock": {
   "s": 0.7,
   "note": "stops, rears, hoots; the dive target is Wick's position when the lock ends"
  },
  "dive": {
   "s": 0.5,
   "speed_px_s": 240,
   "length_px": 120,
   "overshoot_px": 40,
   "lock_range_px": 80,
   "frames": 6,
   "note": "a straight line through Wick's position when the lock ends and 40 px past it: locked from ~80 px away that is 120 px in 0.5 s. From another range keep 240 px/s and the 40 px overshoot, so the time changes; play the 6 frames by progress (frame = floor(6 * distance done / dive length))."
  },
  "recover": {
   "s": 0.9,
   "note": "tumbles, shakes its head, slow: the window to shoot it"
  },
  "targetable": {
   "below_altitude_px": 16,
   "states": [
    "dive",
    "recover"
   ],
   "per_frame": "frame_data.targetable",
   "rule": "the owl can't be hit while high (altitude >= 16 px: fly, lock, spawn, hurt): Wick's shots, the toll splash and the firefly stings pass under it, and the auto-aim skips it. It can only be hit low, in the DIVE and the RECOVER tumble (every frame of both is under 16 px). Shots already flying when it drops low can hit it.",
   "why": "alone it used to die in the 0.7 s LOCK before teaching the sidestep; now the dodge comes first and the recover is the window"
  },
  "repeat": "cruise -> lock -> dive -> recover -> cruise",
  "formations": "parliaments of 3 from ~3:30 that lock one after another (stagger the locks ~0.35 s)"
 },
 "tells": {
  "lock": {
   "animation": "lock",
   "frame": 0,
   "what": "the pale V of the wing undersides, the flared face disc and wide eyes, the crouch; the owl stops dead (the shadow sharpens as it rises)"
  },
  "hoot": {
   "effect": "hoot",
   "sound": "owl_hoot",
   "when": "LOCK frame 0, at the head top",
   "sound_sold": "when SOUND is sold the hoot is gone AND its visible rings vanish with it: the lock keeps only its pale V (that is the trade-off)"
  },
  "dive": {
   "animation": "dive",
   "effect": "dive_smear",
   "sound": "owl_whoosh",
   "when": "dive frame 0"
  },
  "recover": {
   "animation": "recover",
   "what": "tumble, dizzy sparks: shoot now",
   "sound": "owl_ruffle",
   "when": "recover frame 0"
  },
  "other_sounds": {
   "hurt": "owl_squawk",
   "death": "owl_puff",
   "land": "owl_thud",
   "spawn": "owl_wingbeat"
  },
  "sounds": {
   "owl_hoot": "a soft two-note hoo-hoo",
   "owl_whoosh": "a wing whoosh, the dive's rush of air",
   "owl_ruffle": "a feather ruffle",
   "owl_squawk": "a soft squawk",
   "owl_puff": "a soft down puff (death frame 1)",
   "owl_thud": "a low thud (death frame 6, it lands)",
   "owl_wingbeat": "one heavy wingbeat (spawn frame 4, the brake)"
  },
  "sound_ids": "short ids the game calls; SOUND sold silences all of them",
  "sales_that_hurt": [
   "SOUND (no hoot, no hoot rings)",
   "ANIMATIONS (lock frozen on frame 0: still readable, but the shiver and coil timing is gone)",
   "FRAME RATE 20",
   "INPUT DELAY",
   "ICE",
   "UP KEY"
  ]
 },
