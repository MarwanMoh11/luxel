  36,
  14
 ],
 "shadow_anchor": [
  12,
  3
 ],
 "size": "about 13 x 18 px with its outline (body 11 wide, cone 9 wide + lip)",
 "hit_radius": 6,
 "body_radius": 6,
 "centre": [
  0,
  -8
 ],
 "looks": [
  "tin",
  "soot",
  "dent"
 ],
 "rig": {
  "layers": "body = the sprite. flash = cream silhouette inside the outline: swap it for body for 60 ms on a hit (HIT FLASH sold: skip). eyes = only the eye pixels, same frame: in the finale draw eyes alone above the dead pixels. shadow = flat void mask in its own frame, drawn first: shade the ground one step darker (core.SHADE) under it.",
  "looks": "pick one look per snuffer at spawn (weights below); every look shares frames, timing and anchors, only the sheets differ: sheets/<look>/<anim>_<dir>_<layer>.png",
  "look_weights": {
   "tin": 0.45,
   "soot": 0.3,
   "dent": 0.25
  },
  "look_notes": {
   "tin": "pale clean metal, a knobbed handle; the common one",
   "soot": "dark sooted metal, a ring handle; reads a value darker in a crowd",
   "dent": "crooked tip, a dent in the lit face, the handle snapped off"
  },
  "mirror_left": "side faces right; for left flip every layer horizontally around the anchor x (the shadow around shadow_anchor x)",
  "directions": "front = moving down, back = moving up, side = left/right and diagonals (|vx| > 0.7 |vy|); keep the last direction while turning for at least 150 ms",
  "phase": "start each snuffer's hop on a random frame (0..11) so a pack never hops in step",
  "movement": "move at constant speed; the hop is cosmetic. A hop covers ~16 px at 32 px/s.",
  "centre": "frame_data centre = the body centre (anchor-relative) for shots, impacts and splash",
  "death": "on the killing hit play one death_* (weights below) at the snuffer's last position and direction instead of the light's generic body dissolve; it already starts with the cream hit frame and ends in its own dissolve. The light's death_small overlay may play over it at frame_data centre.",
  "death_weights": {
   "death_pop": 0.4,
   "death_flip": 0.35,
   "death_cork": 0.25
  },
  "events": "frame_data event: hit (hit-stop here), pop (death: the cone leaves), clatter (death: the cone lands), land (a hop or spawn landing; no sound for hops: a pack would drown the music)",
  "hit_stop": "freeze only the snuffer for the light's impact hit-stop on hurt frame 0 / death frame 0",
  "y_sort": "sort by the feet anchor y",
  "animations_sold": "loops hold frame 0 (a neutral standing pose); one-shots show frame 0 throughout"
 },
