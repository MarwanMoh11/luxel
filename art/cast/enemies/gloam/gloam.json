  "cycle": "DASH 0.35 s at ~120 px/s toward Wick, angled +-35 deg (alternate the sign each dash: zig-zag), then PAUSE 0.45 s (crouch, eyes blink, face Wick)",
  "dash_s": 0.35,
  "dash_speed": 120,
  "dash_angle_deg": 35,
  "pause_s": 0.45,
  "contact": "touching Wick hurts him like any enemy",
  "visibility": "see reveal: outside every light only the eyes show"
 },
