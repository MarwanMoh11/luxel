 "rig": {
  "layers": "Per frame, all at the same feet anchor: shadow (ground, under everything), body, specks, eyes; death adds stars. Draw order body -> specks -> eyes -> stars.",
  "mirror_left": "side faces right; for left flip body, specks, eyes, flash and stars horizontally (the frame is mirrored whole: anchor x stays) and negate centre.x / eyes.x. Do NOT mirror the shadow (the sun stays in the west): use side *_shadow_left.png, same anchor",
  "directions": "front = moving down, back = moving up, side = left/right and the diagonals",
  "frame_data": "ms per frame; lift = px above the ground (airborne dash frames); centre = body box centre (aim and hits), eyes = centre of the eyes (finale and targeting), anchor-relative, +y down",
  "shadow": "*_shadow.png, frames 60x16, anchor [18, 2] at the feet: one flat colour mask, shade the ground under it one step darker (core.SHADE). Gated by the reveal like the body.",
  "flash": "*_flash.png: the cream silhouette inside the outline (idle, pause, dash, spawn, hurt). On a hit swap the body sheet for it for one frame (~50 ms) and draw it UNGATED: a hit lights the Gloam up even in the dark. hurt frame 0 and death frame 0 are already flashed (also ungated).",
  "specks": "*_specks.png: the star pixels inside the body, drifting on the 2 s world loop and twinkling. They are part of the body (never draw them without it except in the reveal's lead band).",
  "eyes": "*_eyes.png: the two ice eyes plus a 1 px socket of the body's own dark around them (void off the silhouette) so they read on light ground too; the dash frames add the eye trail. ALWAYS drawn.",
  "stars": "death_*_stars.png: the loose stars it unravels into, rising and fading. ALWAYS drawn.",
  "hit_stop": "suggested: freeze 50 ms on hurt frame 0",
  "y_sort": "sort by the feet anchor y",
  "frozen": "ANIMATIONS sold: hold frame 0 of the current animation (every frame 0 is a good still; pause frame 0 is the landing crouch, dash frame 0 the stretch)"
 },
 "reveal": {
  "about": "VISIBILITY IS THE MECHANIC. The game dithers the body in by distance to the nearest light; the eyes never hide. Do it in the sprite's shader, per screen pixel, world-anchored.",
  "lights": {
   "lantern": {
    "centre": "Wick's lantern glass: hero.json emit of his current frame (feet + emit)",
    "radius_by_glow_tier": [
     44,
     58,
     72
    ],
    "full_inside": "radius - 20 (so 24 / 38 / 52 px)"
   },
   "light_pools": {
    "which": "lit props' light pools (the orchard lanterns' pools, lamp posts...), only while BRIGHTNESS is not sold",
    "radius": 30,
    "full_inside": 14
   }
  },
  "rule": "for each light: r = clamp((radius - d) / (radius - full_inside), 0, 1) with d = distance from the pixel's centre (world) to the light centre; reveal = max over lights. Draw a BODY or SHADOW pixel when reveal > core.bayer(world_x, world_y) = (bayer4[y & 3][x & 3] + 0.5) / 16. SPECKS use reveal + 0.3 (the stars show a moment before the dark between them). EYES, STARS and FLASH ignore the reveal.",
  "bayer4": [
   [
    0,
    8,
    2,
    10
   ],
   [
    12,
    4,
    14,
    6
   ],
   [
    3,
